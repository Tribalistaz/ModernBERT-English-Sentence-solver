APP_ENV=production

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=sentence_rebuilder
DB_USER=change_me
DB_PASS=change_me
ADMIN_EMAIL=

PYTHON_BIN=python3
# Optional explicit Python artifact paths. Use when webroot and python are split.
# PYTHON_CLIENT_PATH=../python/predictor_client.py
# PYTHON_SCRIPT_PATH=../python/predictor.py
# PYTHON_DICT_PATH=../python/english_dictionary.txt
SESSION_COOKIE_SECURE=1
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOW_CREDENTIALS=1
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_SECONDS=900
CSRF_TOKEN_TTL_SECONDS=7200

# Windows-only startup helper values (used by Start_servers.bat)
# PHP_EXE=C:\Program Files\PHP\php.exe
# PHP_INI=D:\Athabasca University\COMP 495\CapStone\php\php.ini
